# ============================================================
# Trench Tools practical starter setup
# ============================================================
#
# Copy this file to `.env` and fill in the values below.
# This is intentionally short. Advanced tuning lives in `.env.advanced`.
#
# Never commit your real `.env`.

# ------------------------------------------------------------
# Voluntary Trench Tools fee
# ------------------------------------------------------------
#
# Voluntary fee on supported trade paths. This helps support continued
# development and maintenance.
#
# This value is a percentage:
#   0.1 = 0.1% default
#   0   = off
#   0.2 = 0.2% increased support
# Example: 100 SOL in volume totals 0.1 SOL in support fees at 0.1%.
TRENCH_TOOL_FEE=0.1

# ------------------------------------------------------------
# Launcher
# ------------------------------------------------------------
#
# ee    = execution-engine only (extension trading + PnL)
# ld    = LaunchDeck only (launchdeck-engine + follow daemon)
# both  = full stack, recommended
TRENCH_TOOLS_MODE=both

# ------------------------------------------------------------
# Wallets
# ------------------------------------------------------------
#
# Format:
# SOLANA_PRIVATE_KEY=<privatekey>
# SOLANA_PRIVATE_KEY2=<privatekey>,<tag>
#
# Tagged examples:
# SOLANA_PRIVATE_KEY=YOUR_PRIVATE_KEY,Main Wallet
# SOLANA_PRIVATE_KEY2=YOUR_PRIVATE_KEY,Sniper 2
#
# You can add more wallets with the same pattern:
# SOLANA_PRIVATE_KEY3, SOLANA_PRIVATE_KEY4, ...
SOLANA_PRIVATE_KEY=
SOLANA_PRIVATE_KEY2=
SOLANA_PRIVATE_KEY3=
SOLANA_PRIVATE_KEY4=
SOLANA_PRIVATE_KEY5=

# ------------------------------------------------------------
# Core RPC / websocket
# ------------------------------------------------------------
#
# Main Solana HTTP RPC used for reads, confirmations, and runtime behavior.
# Recommended: Helius Gatekeeper HTTP.
# Replace only YOUR_HELIUS_API_KEY.
SOLANA_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Main Solana websocket used for live watchers.
# Recommended: Helius standard websocket.
# Replace only YOUR_HELIUS_API_KEY.
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Default region profile for region-aware providers.
# Groups: global, us, eu, asia
# Metros: slc, ewr, lon, fra, ams, sg, tyo
# Examples:
# USER_REGION=eu
# USER_REGION=fra
# USER_REGION=fra,ams
USER_REGION=

# Low-priority RPC for startup warmup, keep-warm probes, and compatible
# background state reads. When set, warm/cache traffic can move off
# SOLANA_RPC_URL. Visible wallet, quote, send, and confirmation paths stay
# on SOLANA_RPC_URL.
# Recommended: Shyft. Replace only YOUR_SHYFT_API_KEY.
WARM_RPC_URL=https://rpc.shyft.to?api_key=YOUR_SHYFT_API_KEY

# Low-priority websocket for best-effort warm probes or future
# non-authoritative observers. When set, warm websocket probes can move off
# SOLANA_WS_URL. Live visible subscriptions and confirmations stay on
# SOLANA_WS_URL.
# Recommended: Shyft. Replace only YOUR_SHYFT_API_KEY.
WARM_WS_URL=wss://rpc.shyft.to?api_key=YOUR_SHYFT_API_KEY

# ------------------------------------------------------------
# Optional provider / launchpad keys
# ------------------------------------------------------------

# Optional Hello Moon Lunar Lander API key.
# Only needed if you want to use the Hello Moon provider.
HELLOMOON_API_KEY=

# Optional Bags API key.
# Only needed if you use Bags launchpad flows.
BAGS_API_KEY=

# LaunchDeck report timing detail.
# Supported: off, light, full. Blank/default = full.
LAUNCHDECK_BENCHMARK_MODE=

# ------------------------------------------------------------
# Optional metadata upload
# ------------------------------------------------------------
#
# Pinata is recommended for Pump/Bonk metadata uploads. The free tier is enough
# for normal use: create a free account at https://pinata.cloud/, create an API
# key, and copy the JWT here.
#
# Blank/default uses the launchpad's native metadata flow:
# Pump uses pump-fun upload, Bonk uses Bonk upload endpoints, and Bags uses
# Bags API prepare. Set `pinata` for Pinata-backed uploads for Pump/Bonk.
LAUNCHDECK_METADATA_UPLOAD_PROVIDER=

# Required only when LAUNCHDECK_METADATA_UPLOAD_PROVIDER=pinata.
# Recommended:
#   LAUNCHDECK_METADATA_UPLOAD_PROVIDER=pinata
#   PINATA_JWT=YOUR_PINATA_JWT
PINATA_JWT=

